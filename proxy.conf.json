{
  "/business": {
    "target": "http://localhost:8080", 
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/business": "/api/v1/business" 
    }
  },
  "/business/:id/products": {
    "target": "http://localhost:8080", 
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/business/(\\d+)/products": "/api/v1/business/$1/products" 
    }
  }
}